{
  "name": "school-website-backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "setup-admin": "node src/scripts/setupAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
